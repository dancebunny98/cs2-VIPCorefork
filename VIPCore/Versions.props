<Project>
  <!--
    ЕДИНОЕ МЕСТО ВЕРСИЙ. Меняете здесь - меняется везде: все .csproj, версии плагинов в
    `css_plugins list`, GitHub Actions (SDK, имена артефактов, пути сборки).
    Ни в одном .csproj, .cs или build.yml версии/TFM вручную править не нужно.
  -->

  <!-- Платформа -->
  <PropertyGroup Label="Runtime">
    <!-- Target framework всех проектов. -->
    <DotNetTargetFramework>net10.0</DotNetTargetFramework>
    <!-- Какой .NET SDK ставит GitHub Actions (setup-dotnet). -->
    <DotNetSdkVersion>10.0.x</DotNetSdkVersion>
  </PropertyGroup>

  <!-- Версия продукта -->
  <PropertyGroup Label="Product">
    <!-- Версия ядра (VIPCore) и общего контракта (VipCoreApi). -->
    <PluginVersion>1.3.3</PluginVersion>
    <!-- Версия по умолчанию для ВСЕХ модулей VIP_*. -->
    <ModulesVersion>$(PluginVersion)</ModulesVersion>
    <!--
      Номер сборки. Локально = 0. В GitHub Actions подставляется github.run_number
      (dotnet build -p:BuildNumber=...), итоговая версия выглядит как v1.3.3+build.42.
    -->
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
  </PropertyGroup>

  <!--
    Особые версии отдельных модулей (необязательно): список "ИмяПроекта=версия" через ";".
    Все остальные модули берут ModulesVersion. Пример:
      <ModuleVersionOverrides>VIP_Bhop=1.0.3;VIP_Speed=1.1</ModuleVersionOverrides>
  -->
  <PropertyGroup Label="ModuleOverrides">
    <ModuleVersionOverrides></ModuleVersionOverrides>
  </PropertyGroup>

  <!-- NuGet-зависимости (используются через Directory.Packages.props) -->
  <PropertyGroup Label="Dependencies">
    <CssApiVersion>1.0.376</CssApiVersion>
    <DapperVersion>2.1.79</DapperVersion>
    <MySqlConnectorVersion>2.6.2</MySqlConnectorVersion>
  </PropertyGroup>
</Project>
