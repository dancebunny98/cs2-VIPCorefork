<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<OutputPath>bin\Release\addons\counterstrikesharp\plugins\VIP_DefuseKit\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Configuration>Release</Configuration>
		<DebugType>none</DebugType>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" />
  </ItemGroup>

    <ItemGroup>
    <ProjectReference Include="..\..\VipCoreApi\VipCoreApi.csproj">
      <!-- VipCoreApi.dll резолвится из shared/VipCoreApi/ на сервере -
           не копировать локальную копию в папку плагина, иначе будет
           конфликт типов (два разных VipCoreApi.dll в разных AssemblyLoadContext). -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
