<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.361" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\VipCoreApi\VipCoreApi.csproj">
      <!-- VipCoreApi.dll резолвится из shared/VipCoreApi/ на сервере -
           не копировать локальную копию в папку плагина, иначе будет
           конфликт типов (два разных VipCoreApi.dll в разных AssemblyLoadContext). -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>