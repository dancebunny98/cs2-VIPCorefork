<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The module is distributed as a standalone plugin folder. Keep its
         private NuGet dependencies next to the module assembly. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\VipCoreApi\VipCoreApi.csproj">
      <!-- VipCoreApi.dll резолвится из shared/VipCoreApi/ на сервере -
           не копировать локальную копию в папку плагина, иначе будет
           конфликт типов (два разных VipCoreApi.dll в разных AssemblyLoadContext). -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
