<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.342" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VipCoreApi\VipCoreApi.csproj">
      <!-- VipCoreApi - общий контракт, поставляется из shared/ на сервере.
           Private ДОЛЖЕН быть false - иначе MSBuild копирует свою копию
           VipCoreApi.dll прямо в bin/ ядра, и без страховки в CI (которая
           стирает её из plugins/VIPCore/ постфактум) локальная/ручная сборка
           получила бы дубликат - два разных CLR-типа IVipCoreApi в разных
           AssemblyLoadContext, capability между VIPCore и всеми VIP_*-модулями
           ломается. -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MenuManagerApi">
      <HintPath>..\..\RequirmentsApi\MenuManagerApi.dll</HintPath>
      <!-- Та же причина, что и у VipCoreApi выше - MenuManagerApi.dll тоже
           общий контракт, должен приходить только из shared/MenuManagerApi/. -->
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
