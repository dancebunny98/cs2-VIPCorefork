<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.342" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VipCoreApi\VipCoreApi.csproj">
      <!-- VipCoreApi – общий контракт, поставляется из shared/ на сервере -->
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MenuManagerApi">
      <HintPath>..\MenuManagerApi.dll</HintPath>
      <!-- Если хотите, чтобы MenuManagerApi тоже была в папке плагина, установите <Private>true</Private> или удалите эту строку -->
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
