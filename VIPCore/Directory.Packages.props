<Project>
  <!-- Central Package Management: версии пакетов задаются ТОЛЬКО здесь (значения - в Versions.props, который
       импортируется из Directory.Build.props).
       В .csproj пишем <PackageReference Include="..." /> без Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="CounterStrikeSharp.API" Version="$(CssApiVersion)" />
    <PackageVersion Include="Dapper" Version="$(DapperVersion)" />
    <PackageVersion Include="MySqlConnector" Version="$(MySqlConnectorVersion)" />
  </ItemGroup>
</Project>
